# Separate from the Illustrious image: ComfyUI 0.34.0 natively supports the
# 40-block Anima 2.9B architecture. The OCI index digest prevents tag drift.
FROM runpod/worker-comfyui:5.10.0-base@sha256:e9d18d3db15839ebb10c10c824109fc2956f31ef7bf21916220c008855b0d538

LABEL org.opencontainers.image.title="Aelix private MiaoMiao Anima worker" \
      org.opencontainers.image.description="Private Anima 2.9B ComfyUI worker with exact-version character LoRAs; no model weights are redistributed from this repository" \
      org.opencontainers.image.licenses="LicenseRef-CircleStone-NonCommercial"

COPY scripts/download_loras.py /opt/aelix-anima/download_loras.py
COPY scripts/anima_install.py /opt/aelix-anima/anima_install.py
COPY custom_nodes/aelix_private_lora /comfyui/custom_nodes/aelix_private_lora
COPY catalog/anima-assets.json /opt/aelix-anima/anima-assets.json
COPY catalog/anima-loras.json /opt/aelix-anima/anima-loras.json
COPY ANIMA-NOTICE.md /opt/aelix-anima/NOTICE.md

# The installer refuses missing roles, incompatible LoRA families, non-pinned
# bytes, malformed SafeTensors, HTML error pages and partial downloads.
RUN python /opt/aelix-anima/anima_install.py \
    --kind assets \
    --manifest /opt/aelix-anima/anima-assets.json \
    --output-root /comfyui/models \
    --retries 4 --timeout 90 --min-interval 5 --max-elapsed 1500

# Exact reviewed native/remapped 40-block files are pinned independently of
# the base assets and the Illustrious Dockerfile. Auth-gated files stay out.
RUN python /opt/aelix-anima/anima_install.py \
    --kind loras \
    --manifest /opt/aelix-anima/anima-loras.json \
    --output-root /comfyui/models \
    --allow-empty

CMD ["/start.sh"]
